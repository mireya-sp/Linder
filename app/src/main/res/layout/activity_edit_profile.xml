<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back_arrow"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Atrás"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/trirong"
                android:text="Editar perfil"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

        <TextView
            style="@style/LabelStyle"
            android:fontFamily="@font/nunito"
            android:text="Correo electrónico" />

        <EditText
            android:id="@+id/etEmail"
            style="@style/InputStyle"
            android:fontFamily="@font/nunito"
            android:hint="ejemplo@gmail.com"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/LabelStyle"
            android:fontFamily="@font/nunito"
            android:text="Quiero que me llamen"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etName"
            style="@style/InputStyle"
            android:fontFamily="@font/nunito"
            android:hint="Nombre"
            android:inputType="textPersonName" />

        <TextView
            style="@style/LabelStyle"
            android:fontFamily="@font/nunito"
            android:text="Imágenes del perfil"
            android:layout_marginTop="24dp"/>

        <RelativeLayout
            android:id="@+id/btnImages"
            style="@style/ButtonStyle"
            android:background="?attr/selectableItemBackground">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:text="Modificar mis fotos"
                android:textColor="#FFFFFF" />
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_arrow_forward"
                app:tint="#888888"/>
        </RelativeLayout>

        <TextView
            style="@style/LabelStyle"
            android:fontFamily="@font/nunito"
            android:text="Estoy buscando"
            android:layout_marginTop="16dp"/>

        <RelativeLayout
            android:id="@+id/btnLookingFor"
            style="@style/ButtonStyle"
            android:background="?attr/selectableItemBackground">
            <TextView
                android:id="@+id/tvLookingForValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:text="Una relación seria"
                android:textColor="#FFFFFF" />
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_arrow_forward"
                app:tint="#888888"/>
        </RelativeLayout>

        <TextView
            style="@style/LabelStyle"
            android:fontFamily="@font/nunito"
            android:text="Sobre mí"
            android:layout_marginTop="16dp"/>

        <RelativeLayout
            android:id="@+id/btnAboutMe"
            style="@style/ButtonStyle"
            android:background="?attr/selectableItemBackground">
            <TextView
                android:id="@+id/tvAboutMeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:text="Soy una aficionada a la petanca..."
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_toStartOf="@+id/ivArrowAbout"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="8dp"/>
            <ImageView
                android:id="@+id/ivArrowAbout"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_arrow_forward"
                app:tint="#888888"/>
        </RelativeLayout>

        <TextView
            style="@style/LabelStyle"
            android:fontFamily="@font/nunito"
            android:text="Mi orientación sexual"
            android:layout_marginTop="16dp"/>

        <RelativeLayout
            android:id="@+id/btnSexualOrientation"
            style="@style/ButtonStyle"
            android:background="?attr/selectableItemBackground">
            <TextView
                android:id="@+id/tvSexualOrientationValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:text="Bisexual"
                android:textColor="#FFFFFF" />
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_arrow_forward"
                app:tint="#888888"/>
        </RelativeLayout>

    </LinearLayout>
</ScrollView>